# Leave MSSQL_* empty (or MSSQL_PASSWORD empty) to use in-memory DB without SQL Server.
# Or set USE_MEMORY_DB=1 to force memory DB even when MSSQL_* are set.
# USE_MEMORY_DB=1
# With MSSQL configured: Node 20+ (polyfill) or Node 22+ recommended — see backend/.nvmrc
MSSQL_SERVER=localhost
MSSQL_PORT=1433
MSSQL_DATABASE=AI_BDD_GYM
MSSQL_USER=sa
MSSQL_PASSWORD=
MSSQL_ENCRYPT=true
MSSQL_TRUST_SERVER_CERTIFICATE=true
# Default request timeout was 15s (tedious); migrations / cold start may need longer
MSSQL_CONNECTION_TIMEOUT_MS=30000
MSSQL_REQUEST_TIMEOUT_MS=120000
SESSION_CREATE_RATE_MAX=60
SESSION_CREATE_RATE_WINDOW_MS=60000
# Rate limit counters live in session_create_rate_limits (same DB as carts); shared across app instances when using MSSQL.
# Merchant API (004–006): X-Merchant-Token; legacy MERCHANT_TOKEN implies admin role.
MERCHANT_TOKEN=
# Optional RBAC (006): JSON array [{ "token": "secret", "roles": ["orders"|"menu"|"admin"] }]
# MERCHANT_CREDENTIALS=[{"token":"dev-admin","roles":["admin"]},{"token":"dev-menu","roles":["menu"]},{"token":"dev-orders","roles":["orders"]}]
# Test-only: enable GET /api/_test/internal-error (http-error-handling tests); never set in production
# ENABLE_HTTP_ERROR_TEST_ROUTES=1
# Payment stub (005): success|failure; dev-only body simulate requires ALLOW_PAYMENT_SIMULATE_BODY=true
PAYMENT_SIMULATE_OUTCOME=success
ALLOW_PAYMENT_SIMULATE_BODY=false
PAYMENT_PENDING_STALE_SEC=120
# Test-only: abort pay after pending (integration tests); do not set in production
# PAYMENT_TEST_ABORT_AFTER_PENDING=1
