# Leave MSSQL_* empty and omit USE_MEMORY_DB to use in-memory DB for local dev without SQL Server.
# With MSSQL configured: Node 20+ (polyfill) or Node 22+ recommended — see backend/.nvmrc
MSSQL_SERVER=localhost
MSSQL_PORT=1433
MSSQL_DATABASE=AI_BDD_GYM
MSSQL_USER=sa
MSSQL_PASSWORD=
MSSQL_ENCRYPT=true
MSSQL_TRUST_SERVER_CERTIFICATE=true
SESSION_CREATE_RATE_MAX=60
SESSION_CREATE_RATE_WINDOW_MS=60000
# Rate limit counters live in session_create_rate_limits (same DB as carts); shared across app instances when using MSSQL.
# Merchant API (004): must match X-Merchant-Token from storefront dev / reverse proxy.
MERCHANT_TOKEN=
