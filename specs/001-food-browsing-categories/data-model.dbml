// 資料模型：餐點瀏覽與分類
// @sourceSpec: ./spec.md
// @plan: ./plan.md
// @analysisBoundary: 關聯式資料庫；支援餐點瀏覽、分類及餐點規格資料讀取，非購物車、訂單或管理後台。
// @coveredEndpoints: categories, menu_items

Project restaurant_menu {
  database_type: 'Microsoft SQL Server'
  Note: '''
餐點與分類資料以關聯式資料庫持久化，前端僅讀取資料並呈現菜單。
本迭代不包含購物車寫入、訂單、付款或商店管理邏輯；餐點規格群組與選項作為既有菜單讀取資料的一部分。

=== 端點：關聯式菜單資料 ===
資料契約與不變量：
- categories.id 唯一且不可空
- menu_items.id 唯一且不可空
- menu_items.category_id 必須指向存在的 categories.id
- 同一分類下可包含多筆餐點；同一餐點只有一個主分類
- price 必須為有效貨幣值，且顯示時不得由前端自行計算

交易與失敗處理：
- 本迭代只保留讀取資料流，不設計寫入交易流程
- 若 category_id 缺失或為無效值，查詢應忽略或回應錯誤，避免錯誤分類顯示

=== 跨端點契約（供 API Plan 使用）===
- GET /categories 回傳分類列表
- GET /menu-items 回傳餐點列表，含 category_name、精確十進位字串 price、image_url、is_active 及規格群組／選項
- 若餐點資料缺少圖片、價格或分類，後端需保留空白值以便前端顯示明確錯誤狀態

=== 待確認事項 ===
- 本迭代未決定分類排序與篩選方式
- 本迭代未決定價格幣別與格式
  '''
}

Table categories {
  id uuid [pk]
  name varchar [not null, unique]
  sort_order int [null]
  created_at timestamptz [not null]

  Note: '分類主資料。需求追溯：FR-001, FR-002'
}

Table menu_items {
  id uuid [pk]
  category_id uuid [not null, ref: > categories.id]
  name varchar [not null]
  image_url varchar [null]
  price decimal(10,2) [not null]
  is_active boolean [not null, default: true]
  created_at timestamptz [not null]

  Note: '餐點主資料。需求追溯：FR-001, FR-002, SC-001, SC-002'
}

Table menu_item_option_groups {
  id uuid [pk]
  menu_item_id uuid [not null, ref: > menu_items.id]
  name varchar [not null]

  indexes {
    (id, menu_item_id) [unique]
  }

  Note: '餐點可選規格群組；餐點可沒有群組。由 GET /menu-items 與餐點一併讀取。'
}

Table menu_item_options {
  id uuid [pk]
  menu_item_id uuid [not null]
  option_group_id uuid [not null]
  name varchar [not null]
  price_adjustment numeric [not null, note: '精確十進位數值；幣別及精度沿用菜單價格政策']
  is_active boolean [not null, default: true]

  indexes {
    (id, option_group_id, menu_item_id) [unique]
  }

  Note: '規格選項與目前加價；停用選項不得新選。由 GET /menu-items 與所屬群組一併讀取。'
}

Ref: menu_item_option_groups.(id, menu_item_id) < menu_item_options.(option_group_id, menu_item_id)

// 實體摘要：
// | Category | 餐點分類 | id, name | FR-001, FR-002 |
// | MenuItem | 餐點資訊 | id, category_id, name, price, image_url | FR-001, FR-002 |
